# OPENSPEC:START
# OpenSpec shell completions configuration
# NOTE: only extend fpath here. oh-my-zsh runs compinit itself later, so do
# NOT call compinit in this block (it made compinit run twice, ~330ms).
fpath=("$HOME/.oh-my-zsh/custom/completions" $fpath)
# OPENSPEC:END

#!/bin/bash
# shellcheck disable=SC2155,SC1126,SC1090

# ============================================================================ #
#                                                                              #
#                                    .zshrc                                    #
#                                                                              #
# ============================================================================ #

#    --------------------------------------------------------------------------#
# => globals                                                                   #
#    --------------------------------------------------------------------------#

# common

export TERMINAL=$TERM
export LANG=en_US.UTF-8

export EDITOR=nvim
export BROWSER=/usr/bin/google-chrome-beta

export LS_COLORS="ln=32:di=35;35:ex=40;31;01"
export GPG_TTY=$(tty)

# dev

export SAML2AWS_KEYRING_BACKEND=pass

export GOPATH=$HOME/dev/go
export BOLOS_ENV=$HOME/bolos
export BOLOS_SDK=$HOME/git/nanos-secure-sdk
export GEM_HOME=$HOME/.gem/ruby/2.6.0
export NODE_OPTIONS=--no-warnings
export NX_DAEMON=false
# export NODE_OPTIONS="--max-old-space-size=8192"
# export ANDROID_HOME=/opt/android-sdk
export ANDROID_HOME=$HOME/Android/Sdk

# proto
export PROTO_HOME="$HOME/.proto";
export PATH="$PROTO_HOME/shims:$PROTO_HOME/bin:$PATH";

#    --------------------------------------------------------------------------#
# => oh-my-zsh                                                                 #
#    --------------------------------------------------------------------------#

export ZSH=$HOME/.oh-my-zsh
# Skip the compaudit/compfix security scan on every startup (faster compinit).
export ZSH_DISABLE_COMPFIX="true"
# shellcheck disable=SC2034
CASE_SENSITIVE="true"
# shellcheck disable=SC2034
plugins=()
source "$ZSH/oh-my-zsh.sh"

#    --------------------------------------------------------------------------#
# => zsh-syntax-highlighting                                                   #
#    --------------------------------------------------------------------------#

source "$HOME/git/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

#    --------------------------------------------------------------------------#
# => mise                                                                      #
#    --------------------------------------------------------------------------#

# NOTE: mise is activated ONCE, later in the file, AFTER the modules section
# ("$HOME/.path" does `PATH=''` and rebuilds it, which would wipe mise-managed
# paths). Activating here as well cost ~100ms extra per shell and registered
# the mise precmd hook twice.

#    --------------------------------------------------------------------------#
# => fzf                                                                        #
#    --------------------------------------------------------------------------#

# fzf shell integration is set up below, after mise activation (fzf is a
# mise-managed shim, so it is only on PATH once mise is active).

export FZF_DEFAULT_COMMAND='rg -g !.git/ --hidden --files --follow'
export FZF_CTRL_T_COMMAND='rg -g !.git/ --hidden --files --follow 2>/dev/null'

# nord theme
export FZF_DEFAULT_OPTS=$FZF_DEFAULT_OPTS'
    --color=fg:#e5e9f0,bg:#2E3440,hl:#81a1c1
    --color=fg+:#e5e9f0,bg+:#2E3440,hl+:#81a1c1
    --color=info:#eacb8a,prompt:#bf6069,pointer:#b48dac
    --color=marker:#a3be8b,spinner:#b48dac,header:#a3be8b'

#    --------------------------------------------------------------------------#
# => ssh                                                                       #
#    --------------------------------------------------------------------------#

if [ -z "$SSH_AUTH_SOCK" ] ; then
  echo "> Starting ssh-agent"
  eval "$(ssh-agent -s)"
fi

# In an interactive shell, load the key into the agent. This may prompt once
# for the passphrase; after that the agent keeps the key so git etc. do not
# ask again. Do not redirect stdin from /dev/null here, or ssh-add can never
# read the passphrase and the key is never added.
if [[ -o interactive && -n "$DISPLAY" ]]; then
  if ! ssh-add -l >/dev/null 2>&1; then
    ssh-add
  fi
fi

#    --------------------------------------------------------------------------#
# => modules                                                                   #
#    --------------------------------------------------------------------------#

source "$HOME/.profile"

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"

source "$HOME/.path"
source "$HOME/.gitprompt"
source "$HOME/.prompt"
source "$HOME/.private"
source "$HOME/.env"

# Re-apply mise after local PATH customizations so mise-managed tools
# (node/corepack/pnpm, fzf, etc.) stay available and take precedence.
# Do not cache this output: it contains a snapshot of the current PATH.
if [ -x "$HOME/.local/bin/mise" ]; then
  eval "$("$HOME/.local/bin/mise" activate zsh)"
fi

# fzf shell integration (needs the mise-managed fzf shim on PATH, hence here).
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --zsh)" 2>/dev/null
fi

#    --------------------------------------------------------------------------#
# => bindings                                                                  #
#    --------------------------------------------------------------------------#

wrap() {
  BUFFER=" \$($BUFFER)";
  zle beginning-of-line;
}

wrapProcess() {
  BUFFER=" <($BUFFER)";
  zle beginning-of-line;
}

zle -N wrap
zle -N wrapProcess

bindkey "^X$" wrap
bindkey "^X\<" wrapProcess

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# wt completion (cached: `wt config shell init` spawns wt (~50ms) for a static
# script; regenerate only when the wt binary changes).
if command -v wt >/dev/null 2>&1; then
  _wt_cache="$HOME/.cache/zsh/wt-init.zsh"
  _wt_bin="$(command -v wt)"
  if [[ ! -s "$_wt_cache" || "$_wt_bin" -nt "$_wt_cache" ]]; then
    mkdir -p "${_wt_cache:h}"
    command wt config shell init zsh > "$_wt_cache" 2>/dev/null
  fi
  source "$_wt_cache"
  unset _wt_cache _wt_bin
fi
